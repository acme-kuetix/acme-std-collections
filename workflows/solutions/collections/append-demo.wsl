// Demo workflow for TestCollectionsAppend: calls collections/ops/ops.Append
// on $json.items with element $json.newItem, then responds with the new array.

module append_demo

import collections/ops
import services/common

workflow append_demo {
  start: AppendItem

  state AppendItem {
    action collections/ops/ops.Append(
      arr: $json.items,
      element: $json.newItem
    ) as AppendResult
    on success -> OK
    on error -> Failed
  }

  state OK {
    action services/common/response.Response(
      value: { arr: $AppendResult.response.arr },
      statusCode: 200
    ) as FinalResult
    end ok
  }

  state Failed {
    action services/common/response.Response(
      value: { message: $AppendResult.response.message??"append failed" },
      statusCode: $AppendResult.statusCode??500
    ) as ErrorResult
    end fail
  }
}
