// Sub-workflow for TestCollectionsFilter: reads $element.active and
// responds with {keep: <bool>}. Called per-element by
// collections/ops/ops.Filter to filter a list of maps by their "active"
// field.

module keep_active

import services/common

workflow keep_active {
  start: OK

  state OK {
    action services/common/response.Response(
      value: { keep: $element.active },
      statusCode: 200
    ) as FinalResult
    end ok
  }
}
